// Prisma schema for the Kokyo Run (皇居ラン) ranking app.
// Database: PostgreSQL (Supabase — Direct connection, port 5432).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  photo        String?
  passwordHash String
  selectedBadgeId String?
  statusMessage   String?  // Free-text one-liner shown on ranking and mypage.
  motivation      String?  // Monthly motivation tag (e.g. "今月本気出す").
  createdAt    DateTime @default(now())

  runs           Run[]  @relation("Runner")
  runsToApprove  Run[]  @relation("Approver")
  goals          Goal[]
  achievements   Achievement[]
  eventAttendees EventAttendee[]
  reactions      Reaction[]
}

enum RunStatus {
  PENDING
  APPROVED
  REJECTED
}

model Run {
  id        String    @id @default(cuid())
  date      DateTime
  laps      Int
  status    RunStatus @default(PENDING)
  createdAt DateTime  @default(now())

  // Weather at time of submission — used for future achievement logic.
  weatherTemp Float?  // °C
  weatherCode Int?    // WMO weather code (https://open-meteo.com/en/docs#weathervariables)

  runnerId String
  runner   User   @relation("Runner", fields: [runnerId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation("Approver", fields: [approverId], references: [id], onDelete: Cascade)

  reactions  Reaction[]

  @@index([status])
  @@index([approverId, status])
  @@index([runnerId])
}

model Goal {
  id     String @id @default(cuid())
  year   Int
  month  Int
  targetLaps Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
}

model Achievement {
  id       String   @id @default(cuid())
  badgeId  String
  earnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  date        DateTime  // Date in JST (stored as UTC midnight)
  startTime   String?   // "HH:MM" in JST
  endTime     String?   // "HH:MM" in JST
  location    String?
  description String?
  createdAt   DateTime  @default(now())

  attendees   EventAttendee[]

  @@index([date])
}

model EventAttendee {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Reaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  runId String
  run   Run  @relation(fields: [runId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
  @@index([runId])
}

model MonthlyHero {
  id          String   @id @default(cuid())
  month       String   @unique  // YYYY-MM
  userId      String
  name        String
  laps        Int
  imageUrl    String
  generatedAt DateTime @default(now())
}
