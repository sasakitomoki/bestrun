// Prisma schema for the Kokyo Run (皇居ラン) ranking app.
// Database: PostgreSQL (Render.com).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  // Face photo stored as a Base64 data URL or an external image URL.
  photo        String?
  passwordHash String
  createdAt    DateTime @default(now())

  // Runs submitted by this user.
  runs           Run[]  @relation("Runner")
  // Runs this user is asked to approve.
  runsToApprove  Run[]  @relation("Approver")
  goals          Goal[]
  achievements   Achievement[]
}

enum RunStatus {
  PENDING
  APPROVED
  REJECTED
}

model Run {
  id        String    @id @default(cuid())
  date      DateTime
  laps      Int
  status    RunStatus @default(PENDING)
  createdAt DateTime  @default(now())

  // Weather at time of submission — used for future achievement logic.
  weatherTemp Float?  // °C
  weatherCode Int?    // WMO weather code (https://open-meteo.com/en/docs#weathervariables)

  runnerId String
  runner   User   @relation("Runner", fields: [runnerId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation("Approver", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([approverId, status])
  @@index([runnerId])
}

model Goal {
  id     String @id @default(cuid())
  year   Int
  month  Int
  targetLaps Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
}

model Achievement {
  id       String   @id @default(cuid())
  badgeId  String
  earnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}
