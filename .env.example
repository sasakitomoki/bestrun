# PostgreSQL connection string.
# Local example:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kokyo_run?schema=public"
# On Render.com this is injected automatically from the linked PostgreSQL instance.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Resend API key for email notifications (https://resend.com).
# Create a free account and generate an API key from the dashboard.
RESEND_API_KEY=""

# Public URL of the deployed app (used in notification links).
APP_URL="https://your-app.onrender.com"

# From address for notification emails (must be a verified domain in Resend).
NOTIFY_FROM_EMAIL="noreply@bestrunners.app"
